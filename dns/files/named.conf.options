acl red_privada {
    127.0.0.0/8;
    192.168.57.0/24;
};

options {
    directory "/var/cache/bind";
    recursion yes;
    allow-query { red_privada; };
    allow-recursion { red_privada; };
    forwarders {
        8.8.8.8;
        1.1.1.1;
    };
    dnssec-validation auto;
    listen-on { 127.0.0.1; 192.168.57.5; };
    listen-on-v6 { none; };
};